# Banco PostgreSQL (Neon, Supabase ou local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/central_marketing"
# URL pública da aplicação (usada em links de convite e redefinição de senha)
APP_URL="http://localhost:3000"

# Primeiro administrador criado pelo seed (só se ainda não houver administrador ativo)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@empresa.com.br"
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"

# Opcional: envio de e-mails (convites e redefinição de senha). Sem isso, o sistema
# mostra ao administrador o link para copiar e enviar manualmente.
RESEND_API_KEY=""
EMAIL_FROM="Central de Marketing <nao-responda@empresa.com.br>"

# Deploy no Cloudflare (ver docs/deploy-cloudflare.md)
CLOUDFLARE_ACCOUNT_ID=""
CF_HYPERDRIVE_ID=""
APP_URL_PRODUCTION="https://central-marketing.SEU-SUBDOMINIO.workers.dev"
